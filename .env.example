# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=

# Optional if you use a dedicated Google OAuth web client
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional leftover keys. Google sign-in is no longer required.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# Public URL of this instance (no trailing slash)
AUTH_URL=http://localhost:3000

# Trust host headers behind a reverse proxy
AUTH_TRUST_HOST=true

# TheSportsDB key. Test key "3" works for light local use.
# Register your own at https://www.thesportsdb.com/
THESPORTSDB_API_KEY=3

# Protects /api/cron/refresh
CRON_SECRET=change-me

# Optional local SQLite path. Defaults to ./data/sporttime.db
DATABASE_PATH=

# Required on Vercel. Turso/libSQL hosted database
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional reminder minutes before kickoff (comma-separated)
DEFAULT_REMINDERS=60,1440
